<!-- What every mod of the family has in common: the version, the shared library
     (common/, mod yuta.ffx-mods, referenced but not copied: Fahrenheit loads it once
     from its own folder and shares it), its global usings, and the dependency in the
     manifest (Directory.Build.targets). A mod's csproj sets AssemblyName yuta.<folder>,
     AssemblyTitle and Description. -->
<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <PropertyGroup>
        <Version>0.1.0</Version>
        <Authors>Yutamago</Authors>
        <Product>FFX mods</Product>
        <FhManifestFlags>NONE</FhManifestFlags>
        <FhManifestHomePage>https://github.com/yutamago/ffx-mods</FhManifestHomePage>
        <!-- Comma-separated mod ids, written into the manifest's Dependencies. -->
        <FfxModsDependencies>yuta.ffx-mods</FfxModsDependencies>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)../common/yuta.ffx-mods.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime;native</ExcludeAssets>
        </ProjectReference>
        <Compile Include="$(MSBuildThisFileDirectory)../common/usings.cs" Link="usings.cs" />
        <Using Include="Yuta.FfxMods" />
    </ItemGroup>
</Project>
