<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

    <!-- Fahrenheit.Sdk writes "Dependencies":[] into the manifest; this puts the mod's
         dependencies (FfxModsDependencies) in. Manifest texts must not contain ';'. -->
    <Target Name="__FfxModsManifestDependencies" AfterTargets="__FhEmitManifest" Condition=" '$(FfxModsDependencies)' != '' ">
        <PropertyGroup>
            <__FfxModsManifest>$(PublishDir)/$(AssemblyName).manifest.json</__FfxModsManifest>
            <__FfxModsDeps>&quot;$(FfxModsDependencies.Replace(',', '&quot;,&quot;'))&quot;</__FfxModsDeps>
            <__FfxModsText>$([System.IO.File]::ReadAllText('$(__FfxModsManifest)').Replace('&quot;Dependencies&quot;:[]', '&quot;Dependencies&quot;:[$(__FfxModsDeps)]'))</__FfxModsText>
        </PropertyGroup>
        <WriteLinesToFile File="$(__FfxModsManifest)" Lines="$(__FfxModsText)" Overwrite="true" />
    </Target>

    <!-- The mod's default settings (settings.default.toml) and players' README.txt go into the mod folder.
         settings.default.toml is also embedded in the DLL: the mod's list of its settings and defaults
         (SettingInfo.defaults_of), the same file the converter reads. -->
    <ItemGroup>
        <EmbeddedResource Include="settings.default.toml" LogicalName="settings.default.toml" Condition="Exists('settings.default.toml')" />
        <None Include="settings.default.toml" CopyToPublishDirectory="PreserveNewest" Condition="Exists('settings.default.toml')" />
        <None Include="README.txt" CopyToPublishDirectory="PreserveNewest" Condition="Exists('README.txt')" />
    </ItemGroup>
</Project>
